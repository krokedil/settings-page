{
    "name": "krokedil/settings-page",
    "description": "A package to help setup settings pages in WordPress and WooCommerce for Krokedil plugins to add the Addons and Support tabs",
    "version": "1.3.4",
    "type": "library",
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "php-stubs/woocommerce-stubs": "^8.4",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "lucatume/wp-browser": "^4.5",
        "composer/installers": "^2.0",
        "wpackagist-plugin/woocommerce": "10.8.1",
        "wpackagist-theme/storefront": "4.6.2"
    },
    "license": "GPL-V3-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Krokedil\\SettingsPage\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Krokedil AB",
            "email": "info@krokedil.se"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform-check": false,
        "platform": {
            "php": "8.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "installer-paths": {
            "tests/_plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "tests/_themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "scripts": {
        "test": "codecept run Integration",
        "test:debug": "codecept run Integration --debug",
        "test:reset-db": "@php -r \"is_file('tests/_wordpress/data/db.sqlite') && unlink('tests/_wordpress/data/db.sqlite');\"",
        "makepot": "wp --allow-root i18n make-pot ./src ./languages/krokedil-settings.pot --domain=krokedil-settings",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "lint": "vendor/bin/phpcs . --standard=phpcs.xml --extensions=php -q -s",
        "lint:fix": "vendor/bin/phpcbf . --standard=phpcs.xml --extensions=php -q -s",
        "lint:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcs --standard=phpcs.xml --extensions=php -q -s",
        "lint:fix:changes": "git diff --name-only HEAD~1 | grep '\\.php$' | xargs vendor/bin/phpcbf --standard=phpcs.xml --extensions=php -q -s"
    }
}
